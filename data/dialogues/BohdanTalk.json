    {
      "Id": "saw",
      "Say": [
        {
          "Text": "Бачив її з чоловіком. Привітний такий, у світлому светрі.",
          "Fx": null,
          "Speaker": null
        },
        {
          "Text": "Він її за лікоть підтримував — ну, як підтримують. Я подумав — знайомі.",
          "Fx": null,
          "Speaker": null
        }
      ],
      "Opts": [
        {
          "Text": "Ви розгледіли його обличчя?",
          "To": "face",
          "Need": null,
          "Unless": null,
          "Set": null,
          "Fx": null
        },
        {
          "Text": "Чому ви не втрутились?",
