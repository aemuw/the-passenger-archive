      "IfTo": null
    },
    {
      "Id": "why",
      "Say": [
        {
          "Text": "Що мені було робити? Втручатись? Сказати «ви її знаєте?» А якщо знає?",
          "Fx": null,
          "Speaker": null
        },
        {
          "Text": "Я ж не…",
          "Fx": null,
          "Speaker": null
        }
      ],
      "Opts": [
        {
          "Text": "Могли хоча б подзвонити.",
          "To": "call",
          "Need": null,
          "Unless": null,
          "Set": null,
          "Fx": null
        },
        {
          "Text": "Я розумію.",
