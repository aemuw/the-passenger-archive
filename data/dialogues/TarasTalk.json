      "Next": null,
      "Set": null,
      "Fx": null,
      "IfNeed": null,
      "IfTo": null
    },
    {
      "Id": "know",
      "Say": [
        {
          "Text": "Ні. Хто ж їх знає? Я з жінками обережний.",
          "Fx": null,
          "Speaker": null
        },
        {
          "Text": "У мене сестра така сама — довірлива. Я за неї переживаю.",
