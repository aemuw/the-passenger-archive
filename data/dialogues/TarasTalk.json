    },
    {
      "Id": "levko",
      "Say": [
        {
          "Text": "Левко? Вигадує. Він завжди вигадує.",
          "Fx": null,
          "Speaker": null
        },
        {
          "Text": "Він би і рідного батька виправдав. Або звинуватив.",
