          "Need": null,
          "Unless": "h_n",
          "Set": "h_n",
          "Fx": null
        },
        {
          "Text": "Я не читаю новин.",
          "To": null,
          "Need": null,
          "Unless": null,
          "Set": null,
          "Fx": null
        }
      ],
      "Next": null,
