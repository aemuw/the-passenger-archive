    {
      "Id": "first",
      "Say": [
        {
          "Text": "Ви читали?! Ні? Господи, ви не повірите. Знову на пустирі за вокзалом!",
          "Fx": null,
          "Speaker": null
        }
      ],
      "Opts": [
        {
          "Text": "Що там?",
          "To": "what",
          "Need": null,
          "Unless": null,
          "Set": null,
          "Fx": null
        },
        {
          "Text": "Як вас звати?",
