      "IfTo": null
    },
    {
      "Id": "heard",
      "Say": [
        {
          "Text": "Ви чули нашу розмову?",
          "Fx": null,
          "Speaker": null
        },
        {
          "Text": "Нічого. Тут усе чути, навіть коли говориш тихо.",
          "Fx": null,
          "Speaker": null
        }
      ],
      "Opts": [
        {
          "Text": "Це був ваш чоловік?",
          "To": "husband",
          "Need": null,
          "Unless": "g_h",
          "Set": null,
          "Fx": null
        },
        {
          "Text": "Ви були там після?",
