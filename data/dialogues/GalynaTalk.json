    {
      "Id": "sorry",
      "Say": [
        {
          "Text": "Нічого. Ви не перший, хто слухає.",
          "Fx": null,
          "Speaker": null
        },
        {
          "Text": "Тут усі слухають. А потім їдуть далі.",
