    },
    {
      "Id": "husband",
      "Say": [
        {
          "Text": "Андрій. П'ятнадцять років.",
          "Fx": null,
          "Speaker": null
        },
        {
          "Text": "Він усіх підвозив: сусідів, студентів, діда з вокзалу. «Люди ж», — казав. Така в нього була відповідь на все.",
          "Fx": null,
          "Speaker": null
        }
      ],
      "Opts": null,
