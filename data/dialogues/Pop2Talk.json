      "IfTo": null
    },
    {
      "Id": "ask",
      "Say": [],
      "Opts": [
        {
          "Text": "Не пам'ятаю, звідки.",
          "To": "mem",
          "Need": null,
          "Unless": null,
          "Set": "k:said_dont_remember",
          "Fx": null
        },
        {
          "Text": "До кінцевої.",
          "To": "end",
          "Need": null,
          "Unless": null,
          "Set": "k:said_terminus",
          "Fx": null
        },
        {
          "Text": "А ви?",
