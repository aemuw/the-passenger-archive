    },
    {
      "Id": "first_met",
      "Say": [
        {
          "Text": "О, знайоме обличчя! Ми, здається, перетиналися в тому вагоні?",
          "Fx": null,
          "Speaker": null
        },
        {
          "Text": "Ви ще дивились на мене так, ніби я кредитор. Довго їдете?",
