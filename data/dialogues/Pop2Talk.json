      "Opts": null,
      "Next": "hub",
      "Set": "p2_women",
      "Fx": null,
      "IfNeed": null,
      "IfTo": null
    },
    {
      "Id": "name",
      "Say": [
        {
          "Text": "Максим. Та кажіть просто «Макс», усі кажуть.",
          "Fx": null,
          "Speaker": null
